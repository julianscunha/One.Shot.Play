# Aplicação
NODE_ENV=production
PORT=3456
LOG_LEVEL=info

# Banco de dados (Back4App)
MONGODB_URI=mongodb://localhost:27017/youtube-automation
BACK4APP_DATABASE_URL=mongodb://localhost:27017/youtube-automation

# Segurança
API_KEY=
ALLOWED_ORIGINS=http://localhost:3456

# Provedores de IA
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

# TTS (opcional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Replicate (opcional)
REPLICATE_API_KEY=

# YouTube
YOUTUBE_REGION=BR
DEFAULT_PRIVACY_STATUS=private

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
