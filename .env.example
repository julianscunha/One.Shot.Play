# Configurações do Sistema One.Shot.Play (SQLite)

# Port do servidor
PORT=3456

# Configurações do sistema
CUSTO_LIMITE_DIARIO=1

# Configurações do sistema
DATABASE_PATH=src/data/one-shot-play.db

# Configurações do provedor (exemplos)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Configurações do Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Configurações do YouTube
YOUTUBE_API_KEY=your-youtube-api-key-here
YOUTUBE_CHANNEL_ID=your-youtube-channel-id-here

# Configurações de segurança
API_KEY=your-secure-api-key-here

# Configurações de tempo limite
execution_timeout_ms=300000
retry_delay_ms=10000
